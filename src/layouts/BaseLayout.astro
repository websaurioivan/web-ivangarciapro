---
/**
 * BaseLayout · head SEO, fuentes, header, footer, consentimiento y CTA fijo móvil.
 * <BaseLayout title="…" description="…" pageType="home" jsonLd={…} sticky={{ href, label, cta, intent }}>…</BaseLayout>
 */
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import Consent from '../components/layout/Consent.astro';
import GiftPopup from '../components/layout/GiftPopup.astro';
import { getSettings } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pageType: string;
  jsonLd?: object;
  noindex?: boolean;
  sticky?: { href: string; label: string; cta: string; intent: 'learn' | 'service' | 'newsletter' };
  /** Píldora flotante «¿Quieres un regalo?» (newsletter). false en páginas de conversión de servicio. */
  gift?: boolean;
}
const { title, description, pageType, jsonLd, noindex, sticky, gift = true } = Astro.props;
const settings = await getSettings();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090807" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SeoHead title={title} description={description} jsonLd={jsonLd} noindex={noindex} />
    <Consent gtmId={settings.gtmId} />
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {sticky && <StickyCta {...sticky} />}
    {gift && <GiftPopup />}
    <script>
      import { initClickTracking } from '../lib/analytics';
      import { initStacks } from '../lib/stack';
      initClickTracking();
      initStacks();
    </script>
  </body>
</html>
