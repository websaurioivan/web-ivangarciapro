---
/**
 * Hero · momento wow «Una web, tres verbos».
 * Escritorio: la sección queda fija durante el scroll; los verbos del H1 se encienden por turno
 *   (barrido de oro) y el marco pasa por tres estados: impacta → vende → posiciona.
 * Móvil / sin fijado: los estados avanzan solos cuando están a la vista, con botón de pausa.
 * Reduced motion: sin fijado ni avance automático; el usuario cambia de estado con los botones.
 */
import Button from '../ui/Button.astro';
import BrowserFrame from '../ui/BrowserFrame.astro';

interface Props {
  data: {
    titleStart: string;
    verbs: string[];
    subtitle: string;
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
    steps: { label: string; caption: string }[];
    frameUrl: string;
    frameNote: string;
  };
}
const { data } = Astro.props;
const [v1, v2, v3] = data.verbs;
---

<section class="hero" data-hero data-step="0" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__spot" aria-hidden="true" data-spot></div>

  <div class="hero__pin">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          {data.titleStart}{' '}
          <span class="verb" data-verb="0">{v1}</span>,{' '}
          <span class="verb" data-verb="1">{v2}</span> y{' '}
          <span class="verb" data-verb="2">{v3}</span>.
        </h1>
        <p class="hero__sub">{data.subtitle}</p>
        <div class="hero__ctas" data-hero-top>
          <Button href={data.primary.href} variant="gold" arrow cta="hero_learn" placement="hero" intent="learn">
            {data.primary.label}
          </Button>
          <Button href={data.secondary.href} variant="ghost" cta="hero_service" placement="hero" intent="service">
            {data.secondary.label}
          </Button>
        </div>
      </div>

      <figure class="hero__demo" aria-label="Demostración: una web que impacta, vende y posiciona">
        <BrowserFrame url={data.frameUrl} class="hero__frame">
          <div class="screens">
            <!-- 1 · Impacta -->
            <div class="screen screen--site" data-screen="0">
              <div class="mini">
                <div class="mini__nav rise" style="--i:0">
                  <span class="mini__logo"><i></i>[Tu negocio]</span>
                  <span class="mini__links"><i></i><i></i><i></i></span>
                </div>
                <div class="mini__hero">
                  <div class="mini__copy">
                    <p class="mini__h rise" style="--i:1">[El titular de tu web]</p>
                    <i class="bar rise" style="--i:2"></i>
                    <i class="bar bar--s rise" style="--i:3"></i>
                    <span class="mini__cta rise" style="--i:4">[Tu llamada a la acción]</span>
                  </div>
                  <div class="mini__img rise" style="--i:3"></div>
                </div>
                <div class="mini__row">
                  <i class="rise" style="--i:5"></i><i class="rise" style="--i:6"></i><i class="rise" style="--i:7"></i>
                </div>
              </div>
            </div>

            <!-- 2 · Vende -->
            <div class="screen screen--lead" data-screen="1">
              <div class="lead">
                <p class="lead__title rise" style="--i:0">[Pide tu presupuesto]</p>
                <span class="lead__field rise" style="--i:1"><small>Nombre</small>[Tu cliente]</span>
                <span class="lead__field rise" style="--i:2"><small>Email</small>[cliente@email.com]</span>
                <span class="lead__send rise" style="--i:3">Enviar</span>
              </div>
              <div class="notif rise" style="--i:5">
                <span class="notif__dot"></span>
                <span><strong>Nueva solicitud</strong><small>desde tu web · ahora</small></span>
              </div>
            </div>

            <!-- 3 · Posiciona -->
            <div class="screen screen--serp" data-screen="2">
              <div class="serp">
                <div class="serp__search rise" style="--i:0">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg>
                  [búsqueda de tu cliente]
                </div>
                <div class="serp__result serp__result--top rise" style="--i:1">
                  <small>{data.frameUrl}</small>
                  <p>[Título de tu web en Google]</p>
                  <i class="bar"></i><i class="bar bar--s"></i>
                </div>
                <div class="serp__result rise" style="--i:2"><i class="bar bar--xs"></i><i class="bar bar--m"></i><i class="bar"></i></div>
                <div class="serp__result rise" style="--i:3"><i class="bar bar--xs"></i><i class="bar bar--m"></i><i class="bar"></i></div>
              </div>
            </div>
          </div>
        </BrowserFrame>

        <div class="demo-ctrl">
          <div class="demo-ctrl__steps" role="group" aria-label="Estados de la demostración">
            {
              data.steps.map((s, i) => (
                <button type="button" class="demo-ctrl__step" data-step-btn={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span class="demo-ctrl__bar" aria-hidden="true" />
                  {s.label}
                </button>
              ))
            }
          </div>
          <button type="button" class="demo-ctrl__pause" data-demo-pause aria-pressed="false" hidden>
            <span class="visually-hidden" data-pause-label>Pausar la demostración</span>
            <svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.6" height="9" rx=".6"></rect><rect x="7.4" y="1.5" width="2.6" height="9" rx=".6"></rect></svg>
            <svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.6v8.8L10.4 6z"></path></svg>
          </button>
        </div>
        <figcaption class="demo-caption">
          {data.steps.map((s, i) => <span class="demo-caption__text" data-caption={i}>{s.caption}</span>)}
          <span class="demo-caption__note">{data.frameNote}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const pinMq = matchMedia('(width >= 64rem) and (height >= 40rem)');
    const fine = matchMedia('(pointer: fine)');
    const btns = [...hero.querySelectorAll<HTMLButtonElement>('[data-step-btn]')];
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-demo-pause]');
    const pauseLabel = hero.querySelector<HTMLElement>('[data-pause-label]');
    const STEPS = btns.length;
    let step = 0;
    let timer: number | undefined;
    let inView = false;
    let paused = false;

    const setStep = (i: number) => {
      step = (i + STEPS) % STEPS;
      hero.dataset.step = String(step);
      btns.forEach((b, j) => b.setAttribute('aria-pressed', String(j === step)));
    };

    const pinned = () => pinMq.matches && !reduce.matches;

    /* ── Modo fijado: el scroll decide el estado ── */
    let ticking = false;
    const onScroll = () => {
      if (ticking || !pinned()) return;
      ticking = true;
      requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        const total = hero.offsetHeight - innerHeight;
        const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
        const next = Math.min(STEPS - 1, Math.floor(p * STEPS * 0.999));
        if (next !== step) setStep(next);
        ticking = false;
      });
    };

    /* ── Modo automático (móvil) ── */
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (pinned() || reduce.matches || paused || !inView) return;
      timer = window.setInterval(() => setStep(step + 1), 3400);
    };
    const setPaused = (v: boolean) => {
      paused = v;
      pauseBtn?.setAttribute('aria-pressed', String(v));
      hero.toggleAttribute('data-paused', v);
      if (pauseLabel) pauseLabel.textContent = v ? 'Reanudar la demostración' : 'Pausar la demostración';
      v ? stop() : start();
    };

    const applyMode = () => {
      const pin = pinned();
      hero.classList.toggle('is-pinned', pin);
      if (pauseBtn) pauseBtn.hidden = pin || reduce.matches;
      pin ? (stop(), onScroll()) : start();
    };

    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        if (pinned()) {
          const total = hero.offsetHeight - innerHeight;
          const y = hero.getBoundingClientRect().top + scrollY + total * ((i + 0.5) / STEPS);
          window.scrollTo({ top: y, behavior: 'smooth' });
        } else {
          setStep(i);
          if (!reduce.matches) setPaused(true);
        }
      }),
    );
    pauseBtn?.addEventListener('click', () => setPaused(!paused));

    new IntersectionObserver(([e]) => {
      inView = !!e?.isIntersecting;
      inView ? start() : stop();
    }).observe(hero);

    addEventListener('scroll', onScroll, { passive: true });
    pinMq.addEventListener('change', applyMode);
    reduce.addEventListener('change', applyMode);
    applyMode();

    /* ── Resplandor que sigue al cursor (manual) ── */
    const spot = hero.querySelector<HTMLElement>('[data-spot]');
    if (spot && fine.matches && !reduce.matches) {
      let raf = 0;
      hero.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = hero.getBoundingClientRect();
          spot.style.transform = `translate3d(${e.clientX - r.left}px, ${e.clientY - r.top}px, 0) translate(-50%, -50%)`;
        });
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
  }

  .hero.is-pinned { height: 260svh; }

  .hero__pin {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(48px, 8vh, 96px) var(--s-6);
  }

  .hero.is-pinned .hero__pin {
    position: sticky;
    top: 0;
    min-height: 100svh;
    padding-block: var(--s-6);
  }

  .hero__glow {
    position: absolute;
    top: -360px;
    right: -320px;
    width: 820px;
    height: 820px;
    border-radius: 50%;
    background: var(--g-glow);
    opacity: var(--glow-opacity);
    pointer-events: none;
  }

  .hero__spot {
    position: absolute;
    top: 0;
    left: 0;
    width: 1000px;
    height: 1000px;
    border-radius: 50%;
    background: var(--g-spot);
    transform: translate3d(78vw, 30vh, 0) translate(-50%, -50%);
    transition: transform 1.2s var(--ease);
    pointer-events: none;
    will-change: transform;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (width >= 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(40px, 5vw, 88px);
    }
  }

  /* ── Copy ── */
  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .verb {
    padding-right: 0.06em;
    background: var(--g-gold-text);
    background-position: 100% 50%;
    background-size: 220% 100%;
    background-clip: text;
    color: var(--c-text);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    transition:
      color var(--t-slow) var(--ease),
      background-position var(--t-sweep) var(--ease);
  }

  .hero[data-step="0"] .verb[data-verb="0"],
  .hero[data-step="1"] .verb:is([data-verb="0"], [data-verb="1"]),
  .hero[data-step="2"] .verb {
    background-position: 0% 50%;
    color: transparent;
  }

  .hero__sub {
    max-width: 30rem;
    margin-top: var(--s-5);
    font-size: var(--fs-body-lg);
    line-height: 1.55;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--s-5);
  }

  @media (width < 30rem) {
    .hero__ctas :global(.btn) { flex: 1 1 100%; }
  }

  /* ── Demo ── */
  .hero__demo { margin: 0; }

  .screens {
    position: relative;
    aspect-ratio: 16 / 11;
    container-type: inline-size;
    overflow: hidden;
  }

  .screen {
    position: absolute;
    inset: 0;
    padding: 5cqi;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--t-slow) var(--ease), visibility 0s linear var(--t-slow);
  }

  .hero[data-step="0"] [data-screen="0"],
  .hero[data-step="1"] [data-screen="1"],
  .hero[data-step="2"] [data-screen="2"] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .rise {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity var(--t-slow) var(--ease) calc(var(--i, 0) * 90ms + 120ms),
      transform var(--t-slow) var(--ease) calc(var(--i, 0) * 90ms + 120ms);
  }

  .hero[data-step="0"] [data-screen="0"] .rise,
  .hero[data-step="1"] [data-screen="1"] .rise,
  .hero[data-step="2"] [data-screen="2"] .rise {
    opacity: 1;
    transform: none;
  }

  .bar {
    display: block;
    height: 1.4cqi;
    border-radius: var(--r-full);
    background: var(--c-line-strong);
  }

  .bar--s { width: 62%; }
  .bar--m { width: 78%; }
  .bar--xs { width: 30%; }

  /* Mini web */
  .mini { display: flex; flex-direction: column; gap: 5cqi; height: 100%; }

  .mini__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mini__logo {
    display: flex;
    gap: 1.4cqi;
    align-items: center;
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: 2.4cqi;
    font-weight: 600;
  }

  .mini__logo i {
    width: 1.6cqi;
    height: 1.6cqi;
    border-radius: 50%;
    background: var(--c-ink);
  }

  .mini__links { display: flex; gap: 2cqi; }

  .mini__links i {
    width: 7cqi;
    height: 1.2cqi;
    border-radius: var(--r-full);
    background: var(--c-line-strong);
  }

  .mini__hero {
    display: grid;
    flex: 1;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4cqi;
    align-items: center;
  }

  .mini__copy { display: flex; flex-direction: column; gap: 2.2cqi; }

  .mini__h {
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: 5.6cqi;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .mini__cta {
    align-self: flex-start;
    margin-top: 1.2cqi;
    padding: 1.4cqi 2.6cqi;
    border-radius: var(--r-full);
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: 1.9cqi;
    font-weight: 700;
  }

  .mini__img {
    height: 100%;
    min-height: 22cqi;
    border-radius: var(--r-demo-lg);
    background:
      radial-gradient(80% 70% at 70% 30%, var(--c-gold-28), transparent 70%),
      var(--c-surface-2);
  }

  .mini__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqi; }

  .mini__row i {
    height: 9cqi;
    border: 1px solid var(--c-line);
    border-radius: var(--r-demo-md);
    background: var(--c-surface);
  }

  /* Lead */
  .screen--lead {
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 60% at 50% 40%, var(--c-gold-06), transparent 70%);
  }

  .lead {
    display: flex;
    flex-direction: column;
    gap: 2.2cqi;
    width: min(62cqi, 100%);
    padding: 4.4cqi;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-demo-xl);
    background: var(--c-surface);
  }

  .lead__title {
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: 3.6cqi;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .lead__field {
    display: flex;
    flex-direction: column;
    gap: 0.6cqi;
    padding: 1.6cqi 2.2cqi;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-demo-sm);
    color: var(--c-ink);
    font-size: 2.2cqi;
  }

  .lead__field small { color: var(--c-meta); font-size: 1.6cqi; }

  .lead__send {
    padding: 1.8cqi;
    border-radius: var(--r-full);
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: 2.2cqi;
    font-weight: 700;
    text-align: center;
  }

  .notif {
    position: absolute;
    top: 5cqi;
    right: 5cqi;
    display: flex;
    gap: 1.8cqi;
    align-items: center;
    padding: 1.8cqi 2.6cqi 1.8cqi 2cqi;
    border: 1px solid var(--c-gold-45);
    border-radius: var(--r-full);
    background: var(--c-surface-2);
    color: var(--c-ink);
    font-size: 2cqi;
  }

  .notif span:last-child { display: flex; flex-direction: column; line-height: 1.25; }
  .notif strong { font-weight: 700; }
  .notif small { color: var(--c-meta); font-size: 1.6cqi; }

  .notif__dot {
    width: 1.6cqi;
    height: 1.6cqi;
    border-radius: 50%;
    background: var(--c-gold);
    box-shadow: var(--shadow-dot-sm);
  }

  /* SERP */
  .serp { display: flex; flex-direction: column; gap: 3.4cqi; }

  .serp__search {
    display: flex;
    gap: 2cqi;
    align-items: center;
    padding: 2.2cqi 3cqi;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-full);
    color: var(--c-ink);
    font-size: 2.4cqi;
  }

  .serp__search svg {
    width: 2.6cqi;
    height: 2.6cqi;
    fill: none;
    stroke: var(--c-meta);
    stroke-width: 1.6;
  }

  .serp__result {
    display: flex;
    flex-direction: column;
    gap: 1.3cqi;
    padding-left: 3cqi;
    border-left: 2px solid transparent;
  }

  .serp__result--top {
    padding-block: 2.4cqi;
    border-left-color: var(--c-gold);
    border-radius: 0 var(--r-demo-md) var(--r-demo-md) 0;
    background: linear-gradient(90deg, var(--c-gold-06), transparent 80%);
  }

  .serp__result small { color: var(--c-meta); font-family: var(--f-mono); font-size: 1.8cqi; }

  .serp__result p {
    color: var(--c-gold-light);
    font-family: var(--f-display);
    font-size: 3.4cqi;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* Controles */
  .demo-ctrl {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-4);
  }

  .demo-ctrl__steps {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-2);
  }

  .demo-ctrl__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 44px;
    padding: 0 0 6px;
    border: 0;
    background: none;
    color: var(--c-meta);
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    text-align: left;
    transition: color var(--t-fast) ease;
  }

  .demo-ctrl__step:hover,
  .demo-ctrl__step[aria-pressed="true"] { color: var(--c-ink); }

  .demo-ctrl__bar {
    position: relative;
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: var(--r-full);
    background: var(--c-line-strong);
  }

  .demo-ctrl__bar::after {
    position: absolute;
    inset: 0;
    background: var(--c-gold);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .demo-ctrl__step[aria-pressed="true"] .demo-ctrl__bar::after { transform: scaleX(1); }

  .demo-ctrl__pause {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--c-meta);
  }

  .demo-ctrl__pause[hidden] { display: none; }
  .demo-ctrl__pause:hover { border-color: var(--c-gold-60); color: var(--c-ink); }
  .demo-ctrl__pause svg { width: 10px; height: 10px; fill: currentColor; }
  .demo-ctrl__pause .i-play { display: none; }
  .hero[data-paused] .demo-ctrl__pause .i-play { display: block; }
  .hero[data-paused] .demo-ctrl__pause .i-pause { display: none; }

  .demo-caption {
    display: grid;
    gap: 6px;
    margin-top: var(--s-2);
    font-size: var(--fs-small);
  }

  .demo-caption__text { display: none; color: var(--c-text); }

  .hero[data-step="0"] [data-caption="0"],
  .hero[data-step="1"] [data-caption="1"],
  .hero[data-step="2"] [data-caption="2"] { display: block; }

  .demo-caption__note {
    color: var(--c-meta);
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__spot { display: none; }
    .rise { transition: none; }
  }
</style>
