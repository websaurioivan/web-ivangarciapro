---
/**
 * AuthorBox · quién escribe (E-E-A-T): foto, experiencia, canal y salida al servicio.
 */
import Placeholder from '../ui/Placeholder.astro';
import { getSettings } from '../../lib/site';

const settings = await getSettings();
---

<aside class="ab" aria-label="Sobre el autor">
  <Placeholder label="Foto de Iván" ratio="1/1" round class="ab__photo" />
  <div class="ab__body">
    <p class="ab__kicker mono">Escrito por</p>
    <p class="ab__name">Iván <span class="serif-em">García</span></p>
    <p class="ab__bio">
      Creo webs con inteligencia artificial que impactan, venden y posicionan en Google, y enseño a hacerlo en YouTube. [Una
      frase real sobre tu experiencia.]
    </p>
    <div class="ab__links">
      {settings.youtubeUrl && <a href={settings.youtubeUrl} rel="noopener" target="_blank">Ver el canal de YouTube →</a>}
      <a href="/diseno-web" data-cta="guide_author_service" data-placement="guide_author" data-intent="service">¿Prefieres que la haga yo? →</a>
    </div>
  </div>
</aside>

<style>
  .ab {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--s-4);
    align-items: start;
    margin-block: var(--s-6);
    padding-block: var(--s-5);
    border-block: 1px solid var(--c-line);
  }

  .ab :global(.ab__photo) { width: 88px; }
  .ab :global(.ab__photo .ph__label) { font-size: 0.5625rem; }
  .ab__kicker { color: var(--c-meta); }

  .ab__name {
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ab__bio { margin-top: var(--s-2); font-size: var(--fs-small); }

  .ab__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--s-4);
    margin-top: var(--s-2);
  }

  .ab__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-gold);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .ab__links a:hover { color: var(--c-gold-light); }
</style>
