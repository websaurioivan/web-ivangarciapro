---
/**
 * Faq · preguntas frecuentes con <details> nativo (accesible sin JS). Acordeón exclusivo: abrir una cierra la anterior.
 * El JSON-LD FAQPage lo añade la página.
 * <Faq title="Preguntas *frecuentes*" items={[{ q, a }]} />
 */
import { emph } from '../../lib/text';

interface Props {
  title: string;
  items: { q: string; a: string }[];
}
const { title, items } = Astro.props;
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <h2 id="faq-title" set:html={emph(title)} />
    <div class="faq__list">
      {
        items.map((it) => (
          <details class="faq__item" name="faq">
            <summary>
              <span>{it.q}</span>
              <span class="faq__icon" aria-hidden="true">+</span>
            </summary>
            <p>{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Acordeón exclusivo: solo una pregunta abierta. `name` ya lo hace de forma nativa;
  // esto cubre navegadores que aún no lo soportan.
  document.querySelectorAll<HTMLElement>('.faq__list').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLDetailsElement>('.faq__item')];
    items.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => o !== d && o.open && (o.open = false));
      }),
    );
  });
</script>

<style>
  .faq__grid { display: grid; gap: var(--s-6); }

  @media (width >= 56rem) {
    .faq__grid { grid-template-columns: 4fr 8fr; align-items: start; }
    .faq__grid h2 { position: sticky; top: var(--s-8); }
  }

  .faq__list { border-top: 1px solid var(--c-line); }
  .faq__item { border-bottom: 1px solid var(--c-line); }

  .faq__item summary {
    display: flex;
    gap: var(--s-4);
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding-block: var(--s-4);
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--c-gold-light); }

  .faq__icon {
    flex: none;
    color: var(--c-gold);
    font-family: var(--f-sans);
    font-size: 1.5rem;
    font-weight: 400;
    transition: transform var(--t-med) var(--ease);
  }

  .faq__item[open] .faq__icon { transform: rotate(45deg); }

  .faq__item p {
    max-width: 60ch;
    padding-bottom: var(--s-4);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
</style>
