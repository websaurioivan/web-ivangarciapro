---
/**
 * ModesTable · comparativa Pago único / Fraccionado / Renting (tabla real, accesible).
 * En móvil cada modalidad se convierte en un bloque apilado (no hay scroll horizontal).
 */
import { emph } from '../../lib/text';

interface Props {
  title: string;
  intro: string;
  columns: string[];
  rows: { label: string; values: string[] }[];
  extrasTitle: string;
  extras: string[];
}
const { title, intro, columns, rows, extrasTitle, extras } = Astro.props;
const isCheck = (v: string) => v.trim() === '✓';
---

<section class="section modes" aria-labelledby="modes-title">
  <div class="container">
    <div class="section-head">
      <h2 id="modes-title" set:html={emph(title)} />
      <p>{intro}</p>
    </div>

    <table class="modes__table">
      <caption class="visually-hidden">Comparativa de modalidades de pago</caption>
      <thead>
        <tr>
          <td></td>
          {columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.values.map((v, i) => (
                <td data-col={columns[i]}>
                  {isCheck(v) ? (
                    <span class="modes__check">
                      <span aria-hidden="true">✓</span>
                      <span class="visually-hidden">Incluido</span>
                    </span>
                  ) : (
                    v
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>

    <!-- Móvil: una tarjeta por modalidad -->
    <div class="modes__cards">
      {
        columns.map((c, ci) => (
          <div class="modes__card">
            <p class="modes__card-title">{c}</p>
            <dl>
              {rows.map((r) => (
                <div>
                  <dt>{r.label}</dt>
                  <dd class:list={[isCheck(r.values[ci] ?? '') && 'is-check']}>{r.values[ci]}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <div class="modes__extras">
      <p class="mono">{extrasTitle}</p>
      <ul role="list">
        {extras.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Escritorio: tabla */
  .modes__table {
    display: none;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  @media (width >= 56rem) {
    .modes__table { display: table; }
  }

  .modes__table thead th {
    padding: 0 var(--s-3) var(--s-3);
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: left;
  }

  .modes__table tbody th {
    width: 26%;
    padding: var(--s-3) var(--s-3) var(--s-3) 0;
    color: var(--c-meta);
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    font-weight: 400;
    text-align: left;
  }

  .modes__table td {
    padding: var(--s-3);
    color: var(--c-ink);
    vertical-align: baseline;
  }

  .modes__table tbody tr { border-top: 1px solid var(--c-line); }
  .modes__table tbody tr:last-child { border-bottom: 1px solid var(--c-line); }

  .modes__table tbody td:last-child,
  .modes__table thead th:last-child { background: var(--c-gold-06); }

  .modes__check { color: var(--c-gold); }

  /* Móvil: tarjetas */
  .modes__cards { display: grid; gap: var(--s-3); }

  @media (width >= 56rem) {
    .modes__cards { display: none; }
  }

  .modes__card {
    padding: var(--s-4);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .modes__card-title {
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .modes__card dl { margin-top: var(--s-3); }

  .modes__card dl > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-top: 1px solid var(--c-line);
  }

  .modes__card dt { color: var(--c-meta); font-family: var(--f-mono); font-size: var(--fs-mono); }
  .modes__card dd { margin: 0; color: var(--c-ink); font-size: var(--fs-small); }
  .modes__card dd.is-check { color: var(--c-gold); }

  /* Extras */
  .modes__extras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    align-items: center;
    margin-top: var(--s-5);
  }

  .modes__extras .mono { color: var(--c-meta); }
  .modes__extras ul { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  .modes__extras li {
    padding: 6px 12px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-full);
    font-size: var(--fs-micro);
  }
</style>
