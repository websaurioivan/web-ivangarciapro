---
/**
 * Button · botones del manual.
 * - variant="gold": CTA principal. UNO por pantalla. `arrow` solo si lleva a otro sitio.
 * - variant="ghost": alternativa, sin flecha.
 * - variant="text": enlace de acción en oro con flecha.
 * Tracking: `cta` + `placement` + `intent` → evento cta_click (ver lib/analytics).
 * <Button href="/recursos" variant="gold" arrow cta="hero_learn" placement="hero" intent="learn">Aprender gratis</Button>
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'gold' | 'ghost' | 'text';
  arrow?: boolean;
  cta?: string;
  placement?: string;
  intent?: 'learn' | 'service' | 'newsletter' | 'affiliate';
  full?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  type = 'button',
  variant = 'gold',
  arrow = false,
  cta,
  placement,
  intent,
  full = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, full && 'btn--full', className];
const track = { 'data-cta': cta, 'data-placement': placement, 'data-intent': intent };
---

{
  href ? (
    <a href={href} class:list={classes} {...track} {...rest}>
      <span class="btn__label"><slot /></span>
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...track} {...rest}>
      <span class="btn__label"><slot /></span>
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--r-full);
    font-family: var(--f-sans);
    font-size: 1rem;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      gap var(--t-fast) var(--ease),
      background-color var(--t-fast) ease,
      border-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }

  .btn--gold {
    background: var(--c-gold);
    box-shadow: var(--shadow-cta);
    color: var(--c-on-gold);
    font-weight: 700;
  }

  .btn--gold:hover {
    gap: 18px;
    background: var(--c-gold-hover);
    color: var(--c-on-gold);
  }

  .btn--gold:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--c-bg), 0 0 0 4px var(--c-gold);
  }

  .btn--ghost {
    padding: 0 26px;
    border: 1px solid var(--c-ghost-border);
    background: transparent;
    color: var(--c-ink);
    font-weight: 500;
  }

  .btn--ghost:hover {
    border-color: var(--c-gold-60);
    color: var(--c-ink);
  }

  .btn--text {
    gap: 8px;
    min-height: 44px;
    padding: 0;
    background: none;
    color: var(--c-gold);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .btn--text:hover {
    gap: 14px;
    color: var(--c-gold-light);
  }

  .btn--full { width: 100%; }

  .btn[disabled],
  .btn[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.5;
  }
</style>
