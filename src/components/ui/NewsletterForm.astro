---
/**
 * NewsletterForm · captación en píldora del manual → POST /api/newsletter.php (MailerLite).
 * Funciona sin JS (envío normal). Con JS: validación accesible, estados y evento newsletter_signup.
 * <NewsletterForm id="nl-home" placement="home_newsletter" button="Quiero recibirla" microcopy="Gratis · Sin spam…" />
 */
interface Props {
  id: string;
  placement: string;
  button: string;
  microcopy: string;
  leadMagnet?: string;
  source?: string;
}
const { id, placement, button, microcopy, leadMagnet = '', source = 'web' } = Astro.props;
---

<form
  class="nl"
  action="/api/newsletter.php"
  method="post"
  novalidate
  data-newsletter
  data-form-id={id}
  data-placement={placement}
  data-lead-magnet={leadMagnet}
>
  <div class="nl__pill">
    <label class="visually-hidden" for={`${id}-email`}>Tu email</label>
    <input
      class="nl__input"
      id={`${id}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="tu@email.com"
      required
      aria-describedby={`${id}-msg ${id}-micro`}
    />
    <button class="nl__btn" type="submit">{button}</button>
  </div>

  <div class="nl__trap" aria-hidden="true">
    <label for={`${id}-website`}>No rellenes este campo</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="placement" value={placement} />
  <input type="hidden" name="lead_magnet" value={leadMagnet} />
  <input type="hidden" name="ts" value="" data-ts />

  <p class="nl__msg" id={`${id}-msg`} role="status" aria-live="polite"></p>
  <p class="nl__micro" id={`${id}-micro`}>
    {microcopy} <a href="/privacidad">Privacidad</a>
  </p>
</form>

<script>
  import { track } from '../../lib/analytics';

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const msg = form.querySelector<HTMLElement>('.nl__msg')!;
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    const label = btn.textContent ?? '';
    if (ts) ts.value = String(Date.now());
    // Origen exacto (p. ej. «guide:/guias/como-crear-una-pagina-web-con-ia») para saber qué contenido capta más
    const source = form.querySelector<HTMLInputElement>('input[name="source"]');
    if (source && !source.value.includes(':')) source.value = `${source.value}:${location.pathname}`;

    const setState = (state: 'idle' | 'error' | 'loading' | 'ok', text = '') => {
      form.dataset.state = state;
      msg.textContent = text;
      input.setAttribute('aria-invalid', String(state === 'error'));
      btn.disabled = state === 'loading' || state === 'ok';
      btn.setAttribute('aria-busy', String(state === 'loading'));
      btn.textContent = state === 'loading' ? 'Enviando…' : state === 'ok' ? '✓ Hecho' : label;
    };

    input.addEventListener('input', () => {
      if (form.dataset.state === 'error' && EMAIL.test(input.value.trim())) setState('idle');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!value) {
        setState('error', 'Escribe tu email para recibirla.');
        input.focus();
        return;
      }
      if (!EMAIL.test(value)) {
        setState('error', 'Ese email no parece completo. Revisa que tenga @ y un dominio, como nombre@dominio.com.');
        input.focus();
        return;
      }
      setState('loading');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message || 'error');
        setState('ok', 'Listo. Revisa tu email y confirma la suscripción para empezar a recibirla.');
        track('newsletter_signup', {
          form_id: form.dataset.formId,
          placement: form.dataset.placement,
          lead_magnet: form.dataset.leadMagnet,
        });
      } catch {
        setState('error', 'No se ha podido enviar. Inténtalo de nuevo en unos minutos o escríbeme a info@ivangarcia.pro.');
      }
    });
  });
</script>

<style>
  .nl { width: 100%; max-width: 520px; }

  .nl__pill {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    background: var(--c-bg);
    transition: border-color var(--t-fast) ease;
  }

  .nl__pill:focus-within { border-color: var(--c-gold-60); }
  .nl[data-state="error"] .nl__pill { border-color: var(--c-error); }

  .nl__input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 52px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-full);
    background: transparent;
    color: var(--c-ink);
    font-size: 1rem;
  }

  .nl__input::placeholder { color: var(--c-meta); }
  .nl__input:focus-visible { outline: none; }

  .nl__btn {
    flex: 1 1 auto;
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--r-full);
    background: var(--c-gold);
    box-shadow: var(--shadow-cta);
    color: var(--c-on-gold);
    font-size: var(--fs-small);
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--t-fast) ease;
  }

  .nl__btn:hover { background: var(--c-gold-hover); }

  .nl__btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--c-bg), 0 0 0 4px var(--c-gold);
  }

  .nl__btn:disabled { cursor: default; }

  .nl__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .nl__msg:empty { display: none; }

  .nl__msg {
    margin-top: var(--s-3);
    color: var(--c-ink);
    font-size: var(--fs-small);
  }

  .nl[data-state="error"] .nl__msg { color: var(--c-error); }
  .nl[data-state="ok"] .nl__msg::before { content: "✓ "; color: var(--c-gold); }

  .nl__micro {
    margin-top: var(--s-3);
    color: var(--c-meta);
    font-size: var(--fs-micro);
  }

  .nl__micro a {
    color: var(--c-meta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nl__micro a:hover { color: var(--c-ink); }

  @media (width >= 30rem) {
    .nl__pill { flex-wrap: nowrap; border-radius: var(--r-full); }
    .nl__btn { flex: none; }
  }
</style>
