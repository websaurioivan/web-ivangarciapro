---
/**
 * Logo · punto de oro + «Iván» (Clash) + «García» (Instrument Serif cursiva).
 * <Logo href="/" size="sm" />
 */
interface Props {
  href?: string;
  size?: 'sm' | 'md';
}
const { href = '/', size = 'sm' } = Astro.props;
---

<a href={href} class:list={['logo', `logo--${size}`]} aria-label="Iván García · Inicio">
  <span class="logo__dot" aria-hidden="true"></span>
  <span class="logo__name" aria-hidden="true">Iván <span class="logo__surname">García</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    color: var(--c-ink);
  }

  .logo:hover { color: var(--c-ink); }

  .logo__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-gold);
    box-shadow: var(--shadow-dot);
    transition: box-shadow var(--t-med) var(--ease);
  }

  .logo:hover .logo__dot { box-shadow: 0 0 26px 5px var(--c-gold-60); }

  .logo__name {
    font-family: var(--f-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logo__surname {
    font-family: var(--f-serif);
    font-size: 1.17em;
    font-style: italic;
    font-weight: 400;
  }
</style>
