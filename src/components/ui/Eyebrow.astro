---
/**
 * Eyebrow · píldora con punto que brilla.
 * SOLO para información viva o de estado («Nuevo vídeo», «Quedan 7 de 10…»). Nunca decorativa sobre cada H2.
 * <Eyebrow>Nuevo vídeo</Eyebrow>
 */
interface Props {
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { class: className, ...rest } = Astro.props;
---

<span class:list={['eyebrow', className]} {...rest}>
  <span class="eyebrow__dot" aria-hidden="true"></span>
  <span class="eyebrow__text"><slot /></span>
</span>

<style>
  .eyebrow {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    align-self: flex-start;
    padding: 7px 14px 7px 10px;
    border: 1px solid var(--c-gold-28);
    border-radius: var(--r-full);
    background: var(--c-gold-06);
    color: var(--c-ink);
    font-size: var(--fs-micro);
    line-height: 1.3;
  }

  .eyebrow__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-gold);
    box-shadow: var(--shadow-dot-sm);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    50% { opacity: 0.45; }
  }
</style>
